rules_version = '2';
// Solo los dos correos de los socios pueden leer y escribir. CAMBIA LOS CORREOS.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['socio.a@correo.com', 'socio.b@correo.com'];
    }
  }
}
